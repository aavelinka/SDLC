digraph TaskManagerMockup {
    graph [bgcolor="white", fontname="Arial", label="Task Manager — макет основных экранов", labelloc=t, fontsize=22, ranksep=0.55, nodesep=0.35, pad=0.25];
    node [shape=plain, fontname="Arial"];
    edge [style=invis];

    dashboard [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1">
        <TR><TD BGCOLOR="#2563EB" ALIGN="LEFT"><FONT COLOR="white" POINT-SIZE="18"><B>Task Manager</B></FONT></TD><TD BGCOLOR="#2563EB"><FONT COLOR="white">Мои задачи</FONT></TD><TD BGCOLOR="#2563EB"><FONT COLOR="white">Профиль</FONT></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="16"><B>Список дел</B></FONT>  <FONT COLOR="#2563EB">+ Новая задача</FONT></TD></TR>
        <TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#F8FAFC">Поиск… &nbsp; | &nbsp; Все статусы &nbsp; | &nbsp; Все категории &nbsp; | &nbsp; Приоритет</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#DC2626">●</FONT> Подготовить отчёт<BR/><FONT POINT-SIZE="10">Высокий · Сегодня · Учёба</FONT></TD><TD>▢</TD><TD ALIGN="RIGHT">›</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#D97706">●</FONT> Купить продукты<BR/><FONT POINT-SIZE="10">Обычный · Завтра · Личное</FONT></TD><TD>▢</TD><TD ALIGN="RIGHT">›</TD></TR>
        <TR><TD ALIGN="LEFT"><FONT COLOR="#16A34A">●</FONT> Оплатить интернет<BR/><FONT POINT-SIZE="10">Повтор: ежемесячно</FONT></TD><TD>✓</TD><TD ALIGN="RIGHT">›</TD></TR>
      </TABLE>
    >];

    editor [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1">
        <TR><TD BGCOLOR="#1D4ED8" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="16"><B>Новая задача</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">Название</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">Подготовить отчёт</TD></TR>
        <TR><TD ALIGN="LEFT">Описание</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">Краткое описание дела…</TD></TR>
        <TR><TD ALIGN="LEFT">Приоритет</TD><TD ALIGN="LEFT" BGCOLOR="#FEE2E2">Высокий</TD></TR>
        <TR><TD ALIGN="LEFT">Дедлайн</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">25.10.2026 18:00</TD></TR>
        <TR><TD ALIGN="LEFT">Категория</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">Учёба</TD></TR>
        <TR><TD ALIGN="LEFT">Повторение</TD><TD ALIGN="LEFT" BGCOLOR="#F8FAFC">Каждую неделю</TD></TR>
        <TR><TD ALIGN="LEFT">Подзадачи</TD><TD ALIGN="LEFT">☐ Собрать данные<BR/>☐ Оформить выводы</TD></TR>
        <TR><TD COLSPAN="2" ALIGN="RIGHT"><FONT COLOR="#64748B">Отмена</FONT>   <FONT COLOR="#2563EB"><B>Сохранить</B></FONT></TD></TR>
      </TABLE>
    >];

    details [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#CBD5E1">
        <TR><TD BGCOLOR="#1E40AF" COLSPAN="2"><FONT COLOR="white" POINT-SIZE="16"><B>Подготовить отчёт</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">Статус</TD><TD ALIGN="LEFT">Не выполнена</TD></TR>
        <TR><TD ALIGN="LEFT">Прогресс</TD><TD ALIGN="LEFT">1 из 2 подзадач · 50%</TD></TR>
        <TR><TD ALIGN="LEFT" BGCOLOR="#FEF2F2">Дедлайн</TD><TD ALIGN="LEFT" BGCOLOR="#FEF2F2">Сегодня, 18:00</TD></TR>
        <TR><TD ALIGN="LEFT" COLSPAN="2"><B>Подзадачи</B><BR/>☑ Собрать данные<BR/>☐ Оформить выводы</TD></TR>
        <TR><TD COLSPAN="2" ALIGN="RIGHT"><FONT COLOR="#DC2626">Удалить</FONT>   <FONT COLOR="#2563EB">Редактировать</FONT></TD></TR>
      </TABLE>
    >];

    dashboard -> editor -> details;
}
