digraph TaskManagerDashboard {
    graph [bgcolor="white", fontname="Arial", label="TaskManager_Dashboard", labelloc=t, labeljust=l, fontsize=24, rankdir=TB, ranksep=0.72, nodesep=0.55, pad=0.30, splines=ortho];
    node [shape=plain, fontname="Arial"];
    edge [color="#111111", penwidth=1.25, arrowsize=0.70];

    dashboard [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#111111">
        <TR><TD BGCOLOR="#FFFFFF" COLSPAN="2"><FONT POINT-SIZE="9">«part def»</FONT><BR/><FONT POINT-SIZE="20"><B>DashboardPage</B></FONT></TD></TR>
        <TR><TD BGCOLOR="#FFFFFF" COLSPAN="2"><FONT POINT-SIZE="10">attributes</FONT><BR/><B>title</B> = &quot;Task Manager — Список дел&quot;</TD></TR>
      </TABLE>
    >];

    headerPart [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part»</FONT><BR/><FONT POINT-SIZE="15"><B>header: Header</B></FONT></TD></TR>
      </TABLE>
    >];
    filterPart [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part»</FONT><BR/><FONT POINT-SIZE="15"><B>filterPanel: FilterPanel</B></FONT></TD></TR>
      </TABLE>
    >];
    listPart [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part»</FONT><BR/><FONT POINT-SIZE="15"><B>taskList: TaskList</B></FONT></TD></TR>
      </TABLE>
    >];
    categoryPart [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part»</FONT><BR/><FONT POINT-SIZE="15"><B>categoryPanel: CategoryPanel</B></FONT></TD></TR>
      </TABLE>
    >];
    quickAddPart [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part»</FONT><BR/><FONT POINT-SIZE="15"><B>quickAdd: QuickAddTask</B></FONT></TD></TR>
      </TABLE>
    >];

    headerDef [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part def»</FONT><BR/><FONT POINT-SIZE="16"><B>Header</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attributes</FONT><BR/>logo = &quot;Task Manager&quot;<BR/>user = &quot;Профиль пользователя&quot;<BR/>action = &quot;Выйти&quot;</TD></TR>
      </TABLE>
    >];
    filterDef [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part def»</FONT><BR/><FONT POINT-SIZE="16"><B>FilterPanel</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attributes</FONT><BR/>status = &quot;Все / Активные / Выполненные&quot;<BR/>priority = &quot;Низкий ... Критический&quot;<BR/>deadline = &quot;Сегодня / Просроченные&quot;</TD></TR>
      </TABLE>
    >];
    listDef [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part def»</FONT><BR/><FONT POINT-SIZE="16"><B>TaskList</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attributes</FONT><BR/>items = &quot;Список задач&quot;<BR/>sort = &quot;Дедлайн / Приоритет&quot;<BR/>state = &quot;Пусто / Загрузка / Ошибка&quot;</TD></TR>
      </TABLE>
    >];
    categoryDef [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part def»</FONT><BR/><FONT POINT-SIZE="16"><B>CategoryPanel</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attributes</FONT><BR/>categories = &quot;Учёба, Работа, Личное&quot;<BR/>action = &quot;Добавить категорию&quot;</TD></TR>
      </TABLE>
    >];
    quickAddDef [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#111111">
        <TR><TD><FONT POINT-SIZE="9">«part def»</FONT><BR/><FONT POINT-SIZE="16"><B>QuickAddTask</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">attributes</FONT><BR/>title = &quot;Название задачи&quot;<BR/>deadline = &quot;Дедлайн&quot;<BR/>priority = &quot;Приоритет&quot;<BR/>save = &quot;Создать&quot;</TD></TR>
      </TABLE>
    >];

    dashboard -> headerPart [arrowhead=diamond];
    dashboard -> filterPart [arrowhead=diamond];
    dashboard -> listPart [arrowhead=diamond];
    dashboard -> categoryPart [arrowhead=diamond];
    dashboard -> quickAddPart [arrowhead=diamond];

    headerPart -> headerDef;
    filterPart -> filterDef;
    listPart -> listDef;
    categoryPart -> categoryDef;
    quickAddPart -> quickAddDef;

    {rank=same; headerPart; filterPart; listPart; categoryPart; quickAddPart}
    {rank=same; headerDef; filterDef; listDef; categoryDef; quickAddDef}
}
